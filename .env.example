# --- video source ---
# simulated | file | webcam | vast
SOURCE=simulated
# for SOURCE=file : path to a pool/beach video
VIDEO_PATH=
# for SOURCE=webcam : camera index
WEBCAM=0
# detector for real sources: yolo (needs: pip install ultralytics)
DETECTOR=yolo

# --- sponsor integrations (ALL optional; safe simulated fallbacks built in) ---
# VAST AI OS: camera datastream URL for SOURCE=vast
VAST_DATASTREAM_URL=
# NVIDIA Cosmos: video-understanding endpoint used to verify incidents
COSMOS_ENDPOINT=
# Weights & Biases serverless inference (OpenAI-compatible /chat/completions)
WANDB_INFERENCE_URL=
WANDB_API_KEY=
WANDB_MODEL=llama-3.1-8b-instruct
# Guard paging webhook (Slack / PagerDuty / SMS gateway). Unset = log only.
GUARD_WEBHOOK_URL=
